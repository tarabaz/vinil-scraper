# Copia questo file in .env e compila i valori.
# .env NON deve mai essere committato (è già in .gitignore).

# --- Telegram (fase attuale) ---
# Crea un bot con @BotFather su Telegram per ottenere il token.
# Il chat id è quello della chat/canale dove il bot deve scrivere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- eBay Browse API (fasi successive) ---
# https://developer.ebay.com/
EBAY_APP_ID=
EBAY_CERT_ID=

# --- Discogs API (fasi successive, arricchimento prezzi) ---
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# --- AI provider (layer astratto, fasi successive) ---
# Provider e modello non sono hardcoded: si configurano qui.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Soglia di spesa giornaliera per la fase AI cloud (valuta locale, es. EUR).
# Superata la soglia, la fase AI cloud si disattiva per il resto della giornata.
DAILY_AI_BUDGET=1.00
